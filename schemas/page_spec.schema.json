{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editable PowerPoint page specification v4.4",
  "type": "object",
  "required": [
    "route",
    "pages"
  ],
  "properties": {
    "route": {
      "enum": [
        "strict_reconstruction",
        "beautification",
        "redesign",
        "new_deck",
        "image_first",
        "presenter_first",
        "document_style"
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "elements"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string"
          },
          "reference_image": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "component": {
                  "enum": [
                    "title_block",
                    "icon_card",
                    "flow_node",
                    "horizontal_flow",
                    "table_block",
                    "image_text",
                    "timeline",
                    "comparison_matrix"
                  ]
                },
                "type": {
                  "enum": [
                    "text",
                    "shape",
                    "connector",
                    "icon",
                    "image",
                    "table",
                    "chart"
                  ]
                },
                "locked": {
                  "type": "boolean"
                },
                "bbox_norm": {
                  "$ref": "#/$defs/bbox"
                },
                "points_norm": {
                  "$ref": "#/$defs/bbox"
                },
                "from_id": {
                  "type": "string"
                },
                "to_id": {
                  "type": "string"
                },
                "source_ref": {
                  "type": "object",
                  "properties": {
                    "bbox_norm": {
                      "$ref": "#/$defs/bbox"
                    },
                    "verified": {
                      "type": "boolean"
                    }
                  }
                },
                "nodes": {
                  "type": "array"
                },
                "text": {
                  "type": "string"
                },
                "font_size": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "v_align": {
                  "enum": [
                    "top",
                    "middle",
                    "bottom"
                  ]
                },
                "bold": {
                  "type": "boolean"
                },
                "color": {
                  "type": "string"
                },
                "fill": {
                  "type": "string"
                },
                "shape": {
                  "enum": [
                    "rect",
                    "roundrect",
                    "ellipse",
                    "chevron",
                    "triangle",
                    "diamond"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "needs_review": {
                  "type": "boolean"
                },
                "source": {
                  "type": "string"
                },
                "source_bbox_px": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "integer"
                  }
                },
                "arrow": {
                  "enum": [
                    "none",
                    "start",
                    "end",
                    "both"
                  ]
                },
                "line_width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "integer",
                        "boolean"
                      ]
                    }
                  }
                }
              },
              "oneOf": [
                {
                  "required": [
                    "component",
                    "bbox_norm"
                  ]
                },
                {
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          },
          "review_required": {
            "type": "boolean"
          },
          "review_warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "structure_summary": {
            "type": "object",
            "properties": {
              "shape_candidates": {
                "type": "integer",
                "minimum": 0
              },
              "table_candidates": {
                "type": "integer",
                "minimum": 0
              },
              "connector_candidates": {
                "type": "integer",
                "minimum": 0
              },
              "icon_candidates": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "layout_hypotheses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "layout": {
                  "type": "string"
                },
                "candidate_indices": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "needs_review": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          },
          "icon_suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox_px": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "integer"
                  }
                },
                "bbox_norm": {
                  "$ref": "#/$defs/bbox"
                },
                "nearby_text": {
                  "type": "string"
                },
                "icon_suggestions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "icon_id": {
                        "type": "string"
                      },
                      "name_zh": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "relative_path": {
                        "type": "string"
                      },
                      "context_match_score": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "icon_id",
                      "name_zh",
                      "relative_path"
                    ],
                    "additionalProperties": true
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "needs_review": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "slide_size_in": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 40
      },
      "description": "Optional [width_in, height_in] canvas size; omitted means design_tokens.json defaults."
    },
    "source_type": {
      "type": "string"
    },
    "source_image": {
      "type": "string"
    },
    "analysis_status": {
      "enum": [
        "REVIEW_REQUIRED",
        "REVIEWED",
        "READY_FOR_BUILD"
      ]
    },
    "generation_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    }
  }
}
